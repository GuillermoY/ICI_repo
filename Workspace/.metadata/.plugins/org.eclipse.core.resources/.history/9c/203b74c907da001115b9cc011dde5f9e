    public boolean hayFantasmaPegado()             { return hayFantasmaPegado; }
    public boolean hayFantasmaCerca()              { return hayFantasmaCerca; }
    public boolean hayPowerPillYFantasmas()        { return hayPowerPillYFantasmas; }
}

